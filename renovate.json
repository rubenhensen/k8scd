{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "argocd": {
    "managerFilePatterns": [
      "/apps/templates/.+\\.yaml$/"
    ]
  },
  "helm-values": {
    "managerFilePatterns": [
      "/apps/templates/.+\\.yaml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/apps/templates/.+\\.yaml$/",
      "/serpbear/.+\\.yaml$/",
      "/bolletjestrui/.+\\.yaml$/",
      "/gitea/.+\\.yaml$/",
      "/gatus/.+\\.yaml$/",
      "/ntfy/.+\\.yaml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/apps/templates/.+\\.yaml$/"
      ],
      "matchStrings": [
        "repoURL: https://github.com/(?<depName>[^/]+/[^/\\.]+)\\.git\\n\\s+targetRevision: (?<currentValue>.*)"
      ],
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/apps/templates/.+\\.yaml$/"
      ],
      "matchStrings": [
        "repoURL: (?<registryUrl>.*?)\\n\\s+targetRevision: (?<currentValue>[^\\s]+)\\n\\s+chart: (?<depName>[^\\s]+)"
      ],
      "datasourceTemplate": "helm"
    }
  ],
  "packageRules": [
    {
      "description": "Longhorn 1.11.3 and newer need Kubernetes 1.34, see docs/upgrade-k8s-1.33.md",
      "matchPackageNames": [
        "longhorn"
      ],
      "allowedVersions": "<1.11.3"
    },
    {
      "matchDatasources": [
        "helm"
      ],
      "semanticCommits": "enabled",
      "commitMessageTopic": "helm chart {{depName}}",
      "separateMinorPatch": true
    },
    {
      "matchDatasources": [
        "github-tags"
      ],
      "semanticCommits": "enabled",
      "commitMessageTopic": "{{depName}}",
      "separateMinorPatch": true
    }
  ]
}
