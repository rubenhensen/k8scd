{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "customManagers:githubActionsVersions"
  ],
  "argocd": {
    "managerFilePatterns": [
      "/^(?!(nix-infra-machine|backup-testing|docs|tools|\\.github)/)[^/]+/.+\\.yaml$/"
    ]
  },
  "helm-values": {
    "managerFilePatterns": [
      "/apps/templates/.+\\.yaml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/^(?!(nix-infra-machine|backup-testing|docs|tools|\\.github)/)[^/]+/.+\\.yaml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/apps/templates/.+\\.yaml$/"
      ],
      "matchStrings": [
        "repoURL: (?<registryUrl>.*?)\\n\\s+targetRevision: (?<currentValue>[^\\s]+)\\n\\s+chart: (?<depName>[^\\s]+)"
      ],
      "datasourceTemplate": "helm"
    },
    {
      "customType": "regex",
      "description": "CloudNativePG clusters name their image in imageName",
      "managerFilePatterns": [
        "/^[^/]+/postgresql-cluster[^/]*\\.yaml$/"
      ],
      "matchStrings": [
        "imageName: (?<depName>[^:\\s]+):(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "helm"
      ],
      "semanticCommits": "enabled",
      "commitMessageTopic": "helm chart {{depName}}",
      "separateMinorPatch": true
    },
    {
      "description": "CI renders with the same Helm as Argo CD (3.5 ships Helm 4.2); move it together with Argo CD",
      "matchFileNames": [
        ".github/workflows/**"
      ],
      "matchDepNames": [
        "helm/helm"
      ],
      "enabled": false
    },
    {
      "description": "A PostgreSQL major upgrade needs pg_upgrade or a dump, not a tag bump",
      "matchDepNames": [
        "ghcr.io/cloudnative-pg/postgresql",
        "ghcr.io/tensorchord/cloudnative-vectorchord",
        "ghcr.io/tensorchord/cloudnative-pgvecto.rs"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    }
  ]
}
