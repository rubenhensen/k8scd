{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "customManagers:githubActionsVersions"
  ],
  "timezone": "Europe/Amsterdam",
  "argocd": {
    "description": "Every app folder; Renovate's regexes are RE2, which has no lookahead, so the other folders are skipped through ignorePaths",
    "managerFilePatterns": [
      "/^[^/]+/.+\\.yaml$/"
    ],
    "ignorePaths": [
      "nix-infra-machine/**",
      "backup-testing/**",
      "docs/**",
      "tools/**",
      ".github/**"
    ]
  },
  "helm-values": {
    "managerFilePatterns": [
      "/apps/templates/.+\\.yaml$/"
    ]
  },
  "kubernetes": {
    "description": "Every app folder, as for argocd",
    "managerFilePatterns": [
      "/^[^/]+/.+\\.yaml$/"
    ],
    "ignorePaths": [
      "nix-infra-machine/**",
      "backup-testing/**",
      "docs/**",
      "tools/**",
      ".github/**"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/apps/templates/.+\\.yaml$/"
      ],
      "matchStrings": [
        "repoURL: (?<registryUrl>.*?)\\n\\s+targetRevision: (?<currentValue>[^\\s]+)\\n\\s+chart: (?<depName>[^\\s]+)"
      ],
      "datasourceTemplate": "helm"
    },
    {
      "customType": "regex",
      "description": "CloudNativePG clusters name their image in imageName",
      "managerFilePatterns": [
        "/^[^/]+/postgresql-cluster[^/]*\\.yaml$/"
      ],
      "matchStrings": [
        "imageName: (?<depName>[^:\\s]+):(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "helm"
      ],
      "semanticCommits": "enabled",
      "commitMessageTopic": "helm chart {{depName}}",
      "separateMinorPatch": true
    },
    {
      "description": "CI renders with the same Helm as Argo CD (3.5 ships Helm 4.2); move it together with Argo CD",
      "matchFileNames": [
        ".github/workflows/**"
      ],
      "matchDepNames": [
        "helm/helm"
      ],
      "enabled": false
    },
    {
      "description": "A PostgreSQL major upgrade needs pg_upgrade or a dump, not a tag bump",
      "matchDepNames": [
        "ghcr.io/cloudnative-pg/postgresql",
        "ghcr.io/tensorchord/cloudnative-vectorchord",
        "ghcr.io/tensorchord/cloudnative-pgvecto.rs"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "Patch updates of apps that hold little state and are easy to roll back, and of CI's tools, merge themselves once CI passes: three days after the release, in the evening or at the weekend, when the cluster can be reached. Not the databases, operators, Vault, authentik, Longhorn, Velero, immich, Gitea or WordPress. Renovate merges itself; the repo has no branch protection for GitHub's auto-merge to wait on",
      "matchFileNames": [
        "ntfy/**",
        "gatus/**",
        "freshrss/**",
        "serpbear/**",
        "actual-budget/**",
        ".github/workflows/**"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "minimumReleaseAge": "3 days",
      "automerge": true,
      "platformAutomerge": false,
      "automergeSchedule": [
        "* 17-21 * * 1-5",
        "* 10-21 * * 0,6"
      ]
    }
  ]
}
